{
    "name": "avrify",
    "version": "1.0.0",
    "description": "Zod-to-avro converter ",
    "type": "module",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "maintainers": [
        {
            "name": "Igor Savin",
            "email": "kibertoad@gmail.com"
        }
    ],
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json",
        "lint": "biome check . && tsc",
        "lint:fix": "biome check --write .",
        "test": "vitest --typecheck",
        "test:ci": "npm run test -- --coverage",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kibertoad/avrify.git"
    },
    "peerDependencies": {
        "avsc": ">=5.7.7",
        "zod": ">=3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "@biomejs/biome": "1.9.4",
        "@lokalise/biome-config": "^2.0.0",
        "@lokalise/tsconfig": "^1.3.0",
        "@vitest/coverage-v8": "^3.1.4",
        "avsc": "^5.7.7",
        "vitest": "^3.1.4",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "zod": "^3.25.28"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "keywords": ["zod", "avro", "schema", "converter", "conversion"],
    "homepage": "https://github.com/kibertoad/avrify",
    "files": ["README.md", "LICENSE", "dist/*"]
}
